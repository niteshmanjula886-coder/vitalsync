<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Vitalsync" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0F0F0F</item>
        <item name="android:navigationBarColor">#0F0F0F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#0F0F0F</item>
    </style>

    <style name="Theme.Vitalsync.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.Vitalsync</item>
    </style>
</resources>
